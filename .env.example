# Copy this file to ".env" and fill in the values. Never commit ".env".

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Include the database name (here: gayara).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gayara?retryWrites=true&w=majority

# At least 32 random characters. Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# Frontend address(es), separated by commas
CLIENT_ORIGIN=http://localhost:5173

APP_TIMEZONE=Africa/Cairo

# true = Express also serves frontend/dist (one server in production)
SERVE_FRONTEND=false

# Number of reverse proxies in front of the server (hosting providers usually 1)
TRUST_PROXY=0

# Needed by "npm run backup" and restore: 12 characters or more.
# Keep a copy outside this computer: without it a backup cannot be opened.
BACKUP_PASSPHRASE=

# Used only by "npm run create-owner". Remove the password afterwards.
OWNER_NAME=
OWNER_USERNAME=
OWNER_PASSWORD=
